<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏后继续跑字幕生成：申请电池优化白名单（小米还需在「省电策略」里选无限制） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      移动 / 删除别的 App 下载的视频（迅雷、UC 等）。Android 11+ 对这些文件不开放写权限，
      不授予时每次操作都要弹一次系统确认；授予后移动视频才能一次到位。
      仅本地个人使用，不上架 Play（该权限受商店政策限制）。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MagPlay">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            字幕生成放在独立进程 :subtitle：
            识别链路跑的是 sherpa-onnx 原生推理，一旦 native 层 segfault 只死这个进程，
            播放器与主界面不受影响（之前整包被强退就是 native SIGSEGV 打穿了主进程）。
        -->
        <service
            android:name=".subtitle.SubtitleGenerationService"
            android:exported="false"
            android:process=":subtitle"
            android:foregroundServiceType="mediaProcessing" />

        <!--
            模型对比测试（开发期用，adb 直接拉起）：
            am start-foreground-service -n com.magplay/.bench.BenchService 加参数 path / sec / models
            独立进程是为了让 1GB 模型的加载或 native 崩溃都不影响主界面。
        -->
        <service
            android:name=".bench.BenchService"
            android:exported="true"
            android:process=":bench"
            android:foregroundServiceType="mediaProcessing" />

        <!-- 运行日志导出：把 txt 写到 cache/share 后通过 FileProvider 分享出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
